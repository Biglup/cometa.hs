cabal-version: 3.0
name: cometa
version: 0.1.0.0
synopsis: Idiomatic Haskell bindings to cardano-c
description: An experimental foundation for Haskell-owned Cardano domain values.
license: Apache-2.0
license-file: LICENSE
author: Biglup Labs
maintainer: angel.castillob@protonmail.com
category: Blockchain
homepage: https://github.com/Biglup/cometa.hs
bug-reports: https://github.com/Biglup/cometa.hs/issues
build-type: Simple
extra-source-files:
  README.md
  CODING_CONVENTIONS.md
  AGENTS.md
  tools/*.py
  cbits/*.h
  .hlint.yaml
  .clang-format
  .readthedocs.yaml
  assets/*.png
  native/cardano-c.ref
  docs/requirements.txt
  docs/userguide/*.md
  docs/userguide/conf.py
  docs/userguide/_static/*.css
  docs/development/*.md
  docs/development/*.json
  docs/development/*.csv
  test/Fixtures/*.md

source-repository head
  type: git
  location: https://github.com/Biglup/cometa.hs.git

common language
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library core
  import: language
  visibility: private
  hs-source-dirs: internal
  exposed-modules:
    Cometa.Internal.Failure
    Cometa.Internal.Callback
    Cometa.Internal.Provider
    Cometa.Internal.FFI.Provider
    Cometa.Internal.FFI.Native
    Cometa.Internal.Ownership
    Cometa.Internal.Hex
    Cometa.Internal.FFI.Cbor
    Cometa.Internal.Transaction
    Cometa.Internal.FFI.Transaction
    Cometa.Internal.SigningKey
    Cometa.Internal.FFI.SigningKey
    Cometa.Internal.FFI.Ed25519Values
    Cometa.Internal.FFI.Bip32
    Cometa.Internal.FFI.Bip39
    Cometa.Internal.Bip39
    Cometa.Internal.PasswordCrypto
    Cometa.Internal.FFI.PasswordCrypto
    Cometa.Internal.KeyHandler
    Cometa.Internal.FFI.KeyHandler
    Cometa.Internal.Bip32PrivateKey
    Cometa.Internal.FFI.Script
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2
  extra-libraries: cardano-c
  -- The pinned static native archive uses pthread-backed sodium initialization.
  -- Cabal links the archive directly rather than importing its CMake target.
  if os(linux) || os(osx)
    extra-libraries: pthread
  c-sources:
    cbits/cometa_provider.c
    cbits/cometa_cbor.c
    cbits/cometa_transaction.c
    cbits/cometa_signing_key.c
    cbits/cometa_ed25519_values.c
    cbits/cometa_key_handler.c
    cbits/cometa_bip32.c
    cbits/cometa_bip39.c
    cbits/cometa_password_crypto.c
    cbits/cometa_script.c
  include-dirs: cbits
  includes: cometa_provider.h
  cc-options: -std=c11 -Wall -Wextra

library
  import: language
  hs-source-dirs: src
  exposed-modules:
    Cometa
    Cometa.Crypto.Blake2b
    Cometa.Credential
    Cometa.Address.Shelley
    Cometa.Address.Reward
    Cometa.NetworkId
    Cometa.AssetName
    Cometa.PolicyId
    Cometa.AssetId
    Cometa.Value
    Cometa.PlutusData
    Cometa.Metadata
    Cometa.Script
    Cometa.Script.Native
    Cometa.Script.Plutus
    Cometa.Crypto.Ed25519.PublicKey
    Cometa.Crypto.Ed25519.Signature
    Cometa.Crypto.Ed25519.SigningKey
    Cometa.Crypto.Bip32
    Cometa.Crypto.Bip32.PublicKey
    Cometa.Crypto.Bip32.PrivateKey
    Cometa.Crypto.Bip39
    Cometa.Crypto.Pbkdf2
    Cometa.Crypto.Emip3
    Cometa.KeyHandler.Software
    Cometa.Crypto.DerivationPath
    Cometa.Error
    Cometa.Error.Code
    Cometa.Encoding.Cbor
  other-modules:
    Cometa.Internal.Error
    Cometa.Internal.AddressText
    Cometa.Internal.Bip39Pure
    Cometa.Internal.Pbkdf2Pure
    Cometa.Internal.Ed25519SigningKey
  build-depends:
    base >=4.18 && <4.22,
    bech32 >=1.1.10 && <1.2,
    cborg >=0.2.10 && <0.3,
    aeson >=2.2 && <2.3,
    scientific >=0.3.7 && <0.4,
    containers >=0.6.7 && <0.8,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    cometa:core

executable cometa-hash
  import: language
  hs-source-dirs: examples
  main-is: Hash.hs
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    cometa

executable cometa-cbor
  import: language
  hs-source-dirs: examples
  main-is: Cbor.hs
  build-depends:
    base >=4.18 && <4.22,
    cometa

executable cometa-signing
  import: language
  hs-source-dirs: examples
  main-is: Signing.hs
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    transformers >=0.6 && <0.7,
    cometa

executable cometa-bip32
  import: language
  hs-source-dirs: examples
  main-is: Bip32.hs
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    cometa

executable cometa-bip39
  import: language
  hs-source-dirs: examples
  main-is: Bip39.hs
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    transformers >=0.6 && <0.7,
    cometa

executable cometa-password-crypto
  import: language
  hs-source-dirs: examples
  main-is: PasswordCrypto.hs
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    cometa

executable cometa-software-key-handler
  import: language
  hs-source-dirs: examples
  main-is: SoftwareKeyHandler.hs
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    transformers >=0.6 && <0.7,
    cometa

executable cometa-derivation-paths
  import: language
  hs-source-dirs: examples
  main-is: DerivationPaths.hs
  build-depends:
    base >=4.18 && <4.22,
    cometa

executable cometa-addresses
  import: language
  hs-source-dirs: examples
  main-is: Addresses.hs
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    transformers >=0.6 && <0.7,
    cometa

test-suite cometa-test
  import: language
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  c-sources:
    cbits/cometa_error_codes_test.c
    test/cbits/transaction_oracle.c
    test/cbits/derivation_path_oracle.c
    test/cbits/address_oracle.c
    test/cbits/value_oracle.c
    test/cbits/plutus_data_oracle.c
    test/cbits/metadata_oracle.c
    test/cbits/script_oracle.c
  cc-options: -std=c11 -Wall -Wextra
  other-modules:
    Value
    PlutusData
    Metadata
    Scripts
    Fixtures.Scripts
    Fixtures.PlutusData
    Address
    Fixtures.Address
    ErrorCode
    Ownership
    Callback
    Cbor
    Transaction
    Fixtures.Transaction
    Fixtures.Ed25519
    Ed25519
    Bip32
    Fixtures.Bip32
    Bip39
    PasswordCrypto
    SoftwareKeyHandler
    DerivationPath
    Fixtures.Bip39
  ghc-options: -threaded -rtsopts
  build-depends:
    base >=4.18 && <4.22,
    aeson >=2.2 && <2.3,
    scientific >=0.3.7 && <0.4,
    bech32 >=1.1.10 && <1.2,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    cometa,
    cometa:core,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    tasty-hedgehog >=1.4 && <1.5,
    hedgehog >=1.2 && <1.6

executable cometa-assets-values
  import: language
  hs-source-dirs: examples
  main-is: AssetsValues.hs
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    cometa

executable cometa-plutus-data
  import: language
  hs-source-dirs: examples
  main-is: PlutusData.hs
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    cometa

executable cometa-metadata
  import: language
  hs-source-dirs: examples
  main-is: Metadata.hs
  build-depends:
    base >=4.18 && <4.22,
    transformers >=0.6 && <0.7,
    cometa

executable cometa-scripts
  import: language
  hs-source-dirs: examples
  main-is: Scripts.hs
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    transformers >=0.6 && <0.7,
    cometa
