cabal-version: 3.0
name: cometa
version: 0.1.0.0
synopsis: Idiomatic Haskell bindings to cardano-c
description: An experimental foundation for Haskell-owned Cardano domain values.
license: Apache-2.0
license-file: LICENSE
author: Biglup Labs
maintainer: angel.castillob@protonmail.com
category: Blockchain
homepage: https://github.com/Biglup/cometa.hs
bug-reports: https://github.com/Biglup/cometa.hs/issues
build-type: Simple
extra-source-files:
  README.md
  CODING_CONVENTIONS.md
  AGENTS.md
  tools/*.py
  cbits/*.h
  .hlint.yaml
  .clang-format
  .readthedocs.yaml
  assets/*.png
  native/cardano-c.ref
  docs/requirements.txt
  docs/userguide/*.md
  docs/userguide/conf.py
  docs/development/*.md
  docs/development/*.json
  docs/development/*.csv

source-repository head
  type: git
  location: https://github.com/Biglup/cometa.hs.git

common language
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library core
  import: language
  visibility: private
  hs-source-dirs: internal
  exposed-modules:
    Cometa.Internal.Failure
    Cometa.Internal.Callback
    Cometa.Internal.Provider
    Cometa.Internal.FFI.Provider
    Cometa.Internal.FFI.Native
    Cometa.Internal.Ownership
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2
  extra-libraries: cardano-c
  c-sources: cbits/cometa_provider.c
  include-dirs: cbits
  includes: cometa_provider.h
  cc-options: -std=c11 -Wall -Wextra

library
  import: language
  hs-source-dirs: src
  exposed-modules:
    Cometa
    Cometa.Crypto.Blake2b
    Cometa.Error
    Cometa.Error.Code
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    cometa:core

executable cometa-hash
  import: language
  hs-source-dirs: examples
  main-is: Hash.hs
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    cometa

test-suite cometa-test
  import: language
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    ErrorCode
    Ownership
    Callback
  ghc-options: -threaded
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2,
    cometa,
    cometa:core,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    tasty-hedgehog >=1.4 && <1.5,
    hedgehog >=1.2 && <1.6
